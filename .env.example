# Server-side only. The receiver must persist/deliver enquiries before returning 2xx.
# Add deployment-level rate limiting before enabling the public form.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Server-only demo and admin configuration
# Enable explicitly for a local production preview; never use real student data.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
# Required for admin access when NODE_ENV=production. Development fallback: tm-demo-admin.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
